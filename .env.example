# DRISHTI-NET prototype configuration
# Default: throwaway SQLite file, good for a single-machine demo or the fast test loop.
DRISHTI_DATABASE_URL=sqlite:///./storage/drishti.db
# Real PostgreSQL (recommended for anything beyond a single-machine demo): uncomment and point at a
# real server; requires `psycopg2-binary` (already in apps/api/requirements.txt) and applies schema
# via Alembic migrations (apps/api/migrations) instead of create_all — see `make db-upgrade`.
# DRISHTI_DATABASE_URL=postgresql+psycopg2://drishti:drishti@localhost:5432/drishti
DRISHTI_STORAGE_ROOT=./storage                          # local object storage (quarantine/ and accepted/); MinIO in target
DRISHTI_SCANNER_MODE=auto                               # auto | clamav | testgate | unavailable
DRISHTI_CLAMAV_HOST=clamav
DRISHTI_CLAMAV_PORT=3310
DRISHTI_SCAN_TIMEOUT_S=120
DRISHTI_SECRET_KEY=change-me-demo-only
DRISHTI_MAX_UPLOAD_MB=25
DRISHTI_GRAPH_MAX_HOPS=2
DRISHTI_GRAPH_MAX_NODES=150
# Parser resource caps (TASK_BOARD.md Phase 9): bound a single file's structured content, enforced at
# upload validation time, before it is ever accepted for extraction.
DRISHTI_CSV_MAX_ROWS=50000
DRISHTI_JSON_MAX_RECORDS=20000
DRISHTI_PDF_MAX_PAGES=500
# Redis: login-throttle counters only (TASK_BOARD.md Phase 4). Empty = feature disabled (no throttling,
# same as today). Uncomment once a redis-server is reachable (e.g. `make redis-up` for the user-space
# build under ~/.cache/drishti/redis, or the `redis` service if you run docker-compose.yml).
# DRISHTI_REDIS_URL=redis://127.0.0.1:6379/0
DRISHTI_LOGIN_THROTTLE_MAX_ATTEMPTS=5
DRISHTI_LOGIN_THROTTLE_WINDOW_S=900
