# DRISHTI-NET prototype configuration
# Copy this file to .env (chmod 600 .env) and fill in real values.
# Never commit .env — it is in .gitignore.
#
# --- Quick start (single-machine SQLite demo) ---
DRISHTI_DATABASE_URL=sqlite:///./storage/drishti.db
# Request concurrency and the database pool (docs/TROUBLESHOOTING.md). Keep DB_POOL_SIZE + DB_MAX_OVERFLOW >= THREADPOOL_SIZE,
# and the total across API and worker processes below PostgreSQL's max_connections (default 100).
# DRISHTI_THREADPOOL_SIZE=40
# DRISHTI_DB_POOL_SIZE=20
# DRISHTI_DB_MAX_OVERFLOW=30
# DRISHTI_DB_POOL_TIMEOUT_S=10
# DRISHTI_DB_POOL_RECYCLE_S=1800
# DRISHTI_SLOW_REQUEST_MS=2000
# Local object storage (quarantine/ and accepted/). Keep comments on their own lines: systemd EnvironmentFile
# and docker --env-file keep a trailing '# ...' as part of the value.
DRISHTI_STORAGE_ROOT=./storage
# auto | clamav | testgate | unavailable
DRISHTI_SCANNER_MODE=auto
DRISHTI_CLAMAV_HOST=clamav
DRISHTI_CLAMAV_PORT=3310
DRISHTI_SCAN_TIMEOUT_S=120
# SECRET_KEY must be at least 32 random bytes — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DRISHTI_SECRET_KEY=change-me-demo-only
DRISHTI_MAX_UPLOAD_MB=25
DRISHTI_GRAPH_MAX_HOPS=2
DRISHTI_GRAPH_MAX_NODES=150
# Parser resource caps (TASK_BOARD.md Phase 9)
DRISHTI_CSV_MAX_ROWS=50000
DRISHTI_JSON_MAX_RECORDS=20000
DRISHTI_PDF_MAX_PAGES=500
# Redis: login-throttle counters only. Empty = feature disabled.
# DRISHTI_REDIS_URL=redis://127.0.0.1:6379/0
DRISHTI_LOGIN_THROTTLE_MAX_ATTEMPTS=5
DRISHTI_LOGIN_THROTTLE_WINDOW_S=900
# Rate-limit tuning (defaults shown; role-specific values live in config.py). See docs/adr/012-rate-limiting.md.
# DRISHTI_LOGIN_IP_MAX_FAILURES=30
# DRISHTI_LOGIN_IP_WINDOW_S=900
# DRISHTI_LOGIN_ACCOUNT_WINDOW_S=3600
# DRISHTI_LOGIN_ACCOUNT_LOCK_BASE_S=900
# DRISHTI_LOGIN_ACCOUNT_LOCK_MAX_S=14400
# DRISHTI_API_IP_RATE_PER_MIN=600
# Comma-separated proxies whose X-Forwarded-For is trusted (default: loopback and Docker bridge 172.16.0.0/12).
# DRISHTI_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
# Audit display zone (storage and signatures are always UTC) and retention policy value. See docs/AUDIT_LOG_POLICY.md.
# DRISHTI_AUDIT_DISPLAY_TZ=Asia/Kolkata
# DRISHTI_AUDIT_RETENTION_YEARS=7
# Upload policy (docs/UPLOAD_POLICY.md). Per-category defaults in MB; administrators adjust at runtime within the ceilings.
# DRISHTI_UPLOAD_MAX_DOCUMENT_MB=25
# DRISHTI_UPLOAD_MAX_STRUCTURED_MB=25
# DRISHTI_UPLOAD_MAX_ARCHIVE_MB=100
# DRISHTI_UPLOAD_MAX_IMAGE_MB=50
# DRISHTI_UPLOAD_MAX_AUDIO_MB=500
# DRISHTI_UPLOAD_MAX_VIDEO_MB=20480
# DRISHTI_UPLOAD_MAX_FORENSIC_MB=51200
# DRISHTI_UPLOAD_HARD_MAX_MB=51200          # must equal the gateway limit of the streaming route
# DRISHTI_UPLOAD_EXTRACTABLE_MAX_MB=512
# DRISHTI_UPLOAD_MIN_FREE_MB=2048
# DRISHTI_UPLOAD_MAX_CONCURRENT=4
# DRISHTI_SCAN_MAX_MB=25                    # match clamd StreamMaxLength
# DRISHTI_SCAN_TIMEOUT_PER_GB_S=120

# --- Docker Compose production deployment (docker-compose.yml) ---
# These are required when running the full stack via docker compose up.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# DRISHTI_SECRET_KEY=<64-char hex>
# POSTGRES_PASSWORD=<random password>
# NEO4J_PASSWORD=drishti-neo4j-<random>
# MINIO_ROOT_PASSWORD=drishti-minio-<random>
